# NCBI E-utilities API Key (Optional, increases request rate limit from 3 to 10 req/sec)
# NCBI_API_KEY=your_ncbi_api_key_here

# Enable live API queries (Default is true. Set to false to force demonstration cache mode)
ENABLE_LIVE_APIS=true

# Cache TTL in seconds (Default is 3600 seconds / 1 hour)
CACHE_TTL_SECONDS=3600
